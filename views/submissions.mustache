<!DOCTYPE html>
<html>
<head>
    <title>Отправленные данные</title>
    <style>
        table { border-collapse: collapse; width: 100%; margin-bottom: 16px; }
        th, td { border: 1px solid #ccc; padding: 8px; text-align: left; }
        th { background: #f4f4f4; }
        .empty { color: #888; font-style: italic; }
        .actions { margin-top: 16px; }
    </style>
</head>
<body>
    <h1>Отправленные данные</h1>

    {{#items.length}}
    <table>
        <thead>
            <tr>
                <th>Имя</th>
                <th>Город</th>
                <th>Подписка</th>
                <th>createdAt</th>
            </tr>
        </thead>
        <tbody>
            {{#items}}
            <tr>
                <td>{{ username }}</td>
                <td>{{ city }}</td>
                <td>{{ subscribe }}</td>
                <td>{{ createdAt }}</td>
            </tr>
            {{/items}}
        </tbody>
    </table>
    {{/items.length}}

    {{^items.length}}
    <p class="empty">Пока никто ничего не отправлял.</p>
    {{/items.length}}

    <div class="actions">
        <a href="/">← На главную</a>
    </div>
</body>
</html>